  "source_cues": [
    {
      "cue": 19,
      "start_ms": 58912,
      "end_ms": 62541,
      "text": "- Did you say \"mercurial\"?\n- I'm trying to make up for lack of education.",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 20,
      "start_ms": 62716,
      "end_ms": 65742,
      "text": "So every month, I pick a word\nat random out of the dictionary...",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 21,
      "start_ms": 65919,
      "end_ms": 67887,
      "text": "...and use it all that month.",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 22,
      "start_ms": 69689,
      "end_ms": 73147,
      "text": "- My, how...\n- Minimifidian?",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 23,
      "start_ms": 74628,
      "end_ms": 76357,
      "text": "Is that a real word?",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 24,
      "start_ms": 76663,
      "end_ms": 79894,
      "text": "Does a bear extravasate in the forest?",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 25,
      "start_ms": 83136,
      "end_ms": 84501,
      "text": "What?",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 26,
      "start_ms": 86339,
      "end_ms": 87738,
      "text": "No.",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    },
    {
      "cue": 27,
      "start_ms": 88742,
      "end_ms": 91074,
      "text": "Tell the judge the mayor called.",
      "caption_edition": "s01-internal-dvdrip-xvid-sprinter-english--aa9f77600cd9f2b6",
      "offset_status": "not_audio_verified"
    }
  ],
