{"cue": 103, "end_ms": 320040, "kind": "source_caption", "start_ms": 317380, "text": "- Oh, ha, ha."}
{"cue": 104, "end_ms": 328850, "kind": "source_caption", "start_ms": 326590, "text": "Surprise."}
{"cue": 105, "end_ms": 333790, "kind": "source_caption", "start_ms": 332130, "text": "Sheila."}
{"cue": 106, "end_ms": 338290, "kind": "source_caption", "start_ms": 334630, "text": "- Glad to see me?"}
{"cue": 107, "end_ms": 338290, "kind": "source_caption", "start_ms": 334630, "text": "- Yes, of course. Ha, ha."}
{"cue": 108, "end_ms": 341730, "kind": "source_caption", "start_ms": 338470, "text": "- But, uh, last time, I remember--"}
{"cue": 109, "end_ms": 341730, "kind": "source_caption", "start_ms": 338470, "text": "- Shh."}
{"cue": 110, "end_ms": 345070, "kind": "source_caption", "start_ms": 343410, "text": "Don't talk."}
{"cue": 111, "end_ms": 349370, "kind": "source_caption", "start_ms": 345840, "text": "Just listen."}
{"cue": 112, "end_ms": 355840, "kind": "source_caption", "start_ms": 351280, "text": "Our last date was the most intense..."}
