{"cue": 25, "end_ms": 76830, "kind": "source_caption", "start_ms": 75100, "text": "I did."}
{"cue": 26, "end_ms": 80410, "kind": "source_caption", "start_ms": 77010, "text": "Da, da, da, da, da, da."}
{"cue": 27, "end_ms": 83840, "kind": "source_caption", "start_ms": 82040, "text": "At least it rhymes."}
{"cue": 28, "end_ms": 88020, "kind": "source_caption", "start_ms": 85580, "text": "How about that first case, Mac?"}
{"cue": 29, "end_ms": 92880, "kind": "source_caption", "start_ms": 88780, "text": "Maybe we should wait"}
{"cue": 30, "end_ms": 92880, "kind": "source_caption", "start_ms": 88780, "text": "until the aircraft makes its final approach."}
{"cue": 31, "end_ms": 95020, "kind": "source_caption", "start_ms": 93660, "text": "Yoo-hoo."}
{"cue": 32, "end_ms": 96950, "kind": "source_caption", "start_ms": 95190, "text": "Renee!"}
{"cue": 33, "end_ms": 102720, "kind": "source_caption", "start_ms": 100200, "text": "My God, I think he's gonna kiss her."}
{"cue": 34, "end_ms": 113110, "kind": "source_caption", "start_ms": 110770, "text": "I was wrong. He's gonna swallow her."}
{"cue": 35, "end_ms": 118670, "kind": "source_caption", "start_ms": 115680, "text": "- How's my little porkchop?"}
{"cue": 36, "end_ms": 118670, "kind": "source_caption", "start_ms": 115680, "text": "- Delicious."}
{"cue": 37, "end_ms": 123950, "kind": "source_caption", "start_ms": 120580, "text": "- I've never seen Bull so happy."}
{"cue": 38, "end_ms": 123950, "kind": "source_caption", "start_ms": 120580, "text": "- I've never seen Bull so alive."}
{"cue": 39, "end_ms": 126780, "kind": "source_caption", "start_ms": 124120, "text": "I've never seen Bull with a hooker."}
{"cue": 40, "end_ms": 131320, "kind": "source_caption", "start_ms": 128590, "text": "Of course, I don't get out much."}
{"cue": 41, "end_ms": 180270, "kind": "source_caption", "start_ms": 177140, "text": "Porkchop is a hooker?"}
{"cue": 42, "end_ms": 182710, "kind": "source_caption", "start_ms": 180440, "text": "- Are you sure?"}
{"cue": 43, "end_ms": 182710, "kind": "source_caption", "start_ms": 180440, "text": "- Positive."}
{"cue": 44, "end_ms": 186410, "kind": "source_caption", "start_ms": 182880, "text": "She put in so much time in holding"}
