{"cue": 138, "end_ms": 451410, "kind": "source_caption", "start_ms": 448080, "text": "anywhere."}
{"cue": 139, "end_ms": 454810, "kind": "source_caption", "start_ms": 451580, "text": "And I'm very thorough."}
{"cue": 140, "end_ms": 459650, "kind": "source_caption", "start_ms": 455620, "text": "My name happens to be Christine Sullivan,"}
{"cue": 141, "end_ms": 459650, "kind": "source_caption", "start_ms": 455620, "text": "legal aid."}
{"cue": 142, "end_ms": 464260, "kind": "source_caption", "start_ms": 459820, "text": "Renee Carroll, hospitality engineer."}
{"cue": 143, "end_ms": 467550, "kind": "source_caption", "start_ms": 464990, "text": "Listen, I know who you are"}
{"cue": 144, "end_ms": 467550, "kind": "source_caption", "start_ms": 464990, "text": "and I know what you are."}
