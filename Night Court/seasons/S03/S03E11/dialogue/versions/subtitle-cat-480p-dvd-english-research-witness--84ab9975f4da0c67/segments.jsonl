{"cue": 13, "end_ms": 45330, "kind": "source_caption", "start_ms": 44270, "text": "All rise."}
{"cue": 14, "end_ms": 47940, "kind": "source_caption", "start_ms": 45510, "text": "Criminal court part two"}
{"cue": 15, "end_ms": 47940, "kind": "source_caption", "start_ms": 45510, "text": "is now in session..."}
{"cue": 16, "end_ms": 50100, "kind": "source_caption", "start_ms": 48110, "text": "...the honorable, adorable..."}
{"cue": 17, "end_ms": 55550, "kind": "source_caption", "start_ms": 50280, "text": "...kind, compassionate"}
