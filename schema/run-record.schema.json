{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduled Agent Run Record",
  "type": "object",
  "required": ["schema_version","run_id","project","trigger","scheduled_at","started_at","decision","decision_reason","outcome"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type":"string","minLength":8},
    "project": {"type":"string","minLength":1},
    "trigger": {"enum":["hourly","retry","manual","other"]},
    "scheduled_at": {"type":"string","format":"date-time"},
    "started_at": {"type":"string","format":"date-time"},
    "finished_at": {"type":["string","null"],"format":"date-time"},
    "initial_repo_state": {
      "type":"object",
      "properties":{
        "main_sha":{"type":["string","null"]},
        "open_prs":{"type":"array","items":{"type":"integer"}},
        "recent_activity_detected":{"type":"boolean"},
        "recent_activity_summary":{"type":["string","null"]}
      },
      "additionalProperties": true
    },
    "decision": {"enum":["worked","deferred","stopped"]},
    "decision_reason": {"type":"string","minLength":1},
    "work": {
      "type":["object","null"],
      "properties":{
        "summary":{"type":"string"},
        "branch":{"type":["string","null"]},
        "prs_touched":{"type":"array","items":{"type":"integer"}},
        "commits":{"type":"array","items":{"type":"string"}},
        "files_changed":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    "gha": {
      "type":"object",
      "properties":{
        "checked":{"type":"boolean"},
        "waited_for_runs":{"type":"boolean"},
        "runs_started":{"type":"array","items":{"type":["integer","string"]}}
      },
      "additionalProperties": true
    },
    "outcome": {
      "enum":["progress","no_safe_work","concurrency_blocked","waiting_on_ci","waiting_on_external","needs_user_input","error","completed_plan"]
    },
    "blocker":{"type":["string","null"]},
    "retry_scheduled":{"type":"boolean"},
    "retry_after_minutes":{"type":["integer","null"],"minimum":1},
    "next_step":{"type":["string","null"]}
  },
  "additionalProperties": true
}
